# HIV-DR-Watch dev environment — copy to `.env` before `docker compose up -d`.
#
# Nothing sensitive lives here by default; the passwords are local-dev
# defaults. Rotate before exposing any port beyond localhost.

# --- Postgres ---
POSTGRES_USER=hivdrwatch
POSTGRES_PASSWORD=hivdrwatch
POSTGRES_PORT=5432

# --- MinIO (S3-compatible artifact store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_BUCKET=mlflow-artifacts

# --- Prefect ---
PREFECT_PORT=4200

# --- MLflow ---
MLFLOW_PORT=5000

# --- HIV-DR-Watch API (Batch F) ---
API_PORT=8080
HIVDRWATCH_DATABASE_NAME=hivdrwatch
# HIVDRWATCH_DATABASE_URL — leave unset to build from POSTGRES_* above,
# or set explicitly (e.g. sqlite:///./local.db for offline dev).
HIVDRWATCH_API_HOST=0.0.0.0
HIVDRWATCH_API_PORT=8080
HIVDRWATCH_API_CORS_ORIGINS=["*"]
HIVDRWATCH_API_RATE_LIMIT_DEFAULT=100/minute
HIVDRWATCH_API_ENABLE_DOCS=true

# --- Client-side (host worker + CLIs read these) ---
# Same URLs the compose services expose. Change if you remap ports above.
PREFECT_API_URL=http://localhost:4200/api
MLFLOW_TRACKING_URI=http://localhost:5000

# Ask Prefect to also forward these stdlib loggers to the run log,
# so lines from modules that DON'T explicitly use `get_run_logger()`
# still appear in the Prefect UI. Belt-and-suspenders alongside our
# `stream_logger` plumbing.
PREFECT_LOGGING_EXTRA_LOGGERS=hivdrwatch,causal

# MLflow needs the MinIO endpoint + credentials on the CLIENT too when
# it downloads / uploads artifacts.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# --- NCBI E-utilities (GenBank ingestion) ---
# Contact email is REQUIRED by NCBI E-utilities. Rate limit is 3 req/s
# without a key, 10 req/s with. Get a key at:
#   https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
