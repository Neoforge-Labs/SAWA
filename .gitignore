__pycache__
.DS_Store
*.pyc
.coverage
.pytest_cache
.ruff_cache
.mypy_cache

# Virtualenvs
.venv
venv

# Local env / secrets
.env

# --- Data (DVC-tracked; NEVER commit raw data) ---
# Per CLAUDE.md: raw data never enters git. DVC pointers (`*.dvc`) DO
# enter git; the actual data lives on the DVC remote (MinIO/S3).
# Exclude the CONTENTS of these dirs, not the dirs themselves. Git will
# not descend into a wholly-excluded directory, so `data/interim/` would
# silently break the `!*.dvc` re-include below. Using `data/**/**`
# excludes everything at any depth while `!data/**/` re-includes the
# intermediate directories so git actually walks them and honors the
# file-level re-includes for pointers + auto-managed gitignores.
data/**/*
!data/**/
!data/**/*.dvc
!data/**/.gitignore

# DVC internals
.dvc/tmp
.dvc/cache
.dvcignore-cache

# Marimo runtime cache
notebooks/__marimo__/

# Build artifacts we don't want committed
paper1_tools/figures/*.pdf
paper1_tools/figures/*.png
!paper1_tools/figures/.gitkeep

# Benchmark result JSONs ARE committed (feed Fig 5), so no ignore.
